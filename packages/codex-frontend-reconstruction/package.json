{
  "name": "codex-frontend-semantic-reconstruction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independently reconstructed, typed modules based on analysis of a compiled desktop frontend.",
  "scripts": {
    "build:core": "tsc -p tsconfig.core.json",
    "test:core": "npm run build:core && node --test tests/*.test.mjs",
    "demo:dev": "vite --config demo/vite.config.ts",
    "demo:typecheck": "tsc -p demo/tsconfig.json --noEmit",
    "demo:build": "npm run demo:typecheck && vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "demo:check-model": "tsc -p demo/tsconfig.model.json && node --test demo/tests/*.test.mjs",
    "demo:test:e2e": "playwright test --config demo/playwright.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vite": "^6.3.5",
    "@types/node": "^22.0.0",
    "@playwright/test": "^1.56.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "@pierre/diffs": "1.5.1",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.6",
    "prosemirror-history": "^1.5.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-keymap": "^1.2.3"
  }
}
